# Kopier denne fil til .env.local og udfyld værdierne.
# .env.local må ALDRIG commit'es (er allerede i .gitignore via Next.js-konvention).

# Neon Postgres connection string
# Hent fra Neon dashboard → dit projekt → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Bearer-token som iOS-appen sender ved hvert push (PUT /api/sessions/{id})
# Vælg en lang, tilfældig streng, fx: openssl rand -hex 32
LIVE_SESSION_API_SECRET=skift-mig-til-en-hemmelig-vaerdi
